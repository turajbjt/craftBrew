# ==============================================================================
# CraftBrew Web Server Security & Hardening Configuration
# ==============================================================================

# Disable directory browsing
Options -Indexes

# Security Headers
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>

# Block access to hidden files and sensitive directories (.git, .env, etc.)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Block access to sensitive system files, schemas, docs, locks, and scripts
<FilesMatch "(^schema.*\.sql|\.lock|install\.sh|docker-compose.*\.ya?ml|Dockerfile|\.md|composer\.(json|lock))$">
    Require all denied
</FilesMatch>

# Block direct web access to legacy import directory
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^legacy_import(/.*)?$ - [F,L]
    RewriteRule ^scratch(/.*)?$ - [F,L]
</IfModule>
